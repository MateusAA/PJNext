generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma maps the existing Postgres names used by the application.
model User {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  email    String  @unique
  password String
  id_grupo Int?
  group    UserGroup? @relation(fields: [id_grupo], references: [id_group], onDelete: SetNull)
  customer_contacts CustomerContactInfo[]

  @@map("users")
}

model UserGroup {
  id_group    Int    @id @default(autoincrement())
  description String
  users       User[]

  @@map("user_group")
}

model Customer {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  email          String?
  image_url      String?
  cpf            String? @unique
  rg             String?
  cnpj           String? @unique
  razao_social   String?
  nome_fantasia  String?
  ie             String?
  status_id      String  @default("3")
  invoices       Invoice[]
  addresses      CustomerAddress[]
  contact_info   CustomerContactInfo[]
  history        CustomerHistoryContact[]

  @@map("customers")
}

model Invoice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id String   @db.Uuid
  amount      Int
  status      String
  date        DateTime @db.Date
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("invoices")
}

model Revenue {
  month   String @id @db.VarChar(4)
  revenue Int

  @@map("revenue")
}

model CustomerAddress {
  id          Int    @id @default(autoincrement())
  customer_id String @db.Uuid
  rua         String
  numero      String
  cidade      String
  uf          String @db.VarChar(2)
  cep         String
  bairro      String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("tb_costumer_andress")
}

model CustomerContactInfo {
  id             Int    @id @default(autoincrement())
  customer_id    String @db.Uuid
  id_responsavel String @db.Uuid
  tel_cel        String
  email          String
  customer       Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  responsavel    User     @relation(fields: [id_responsavel], references: [id])

  @@index([customer_id])
  @@map("tb_costumer_contact")
}

model TreatmentType {
  treatment_type_id_uuid Int    @id @default(autoincrement())
  description            String
  contacts               CustomerHistoryContact[]

  @@map("tb_treatment_type")
}

model ReturnType {
  return_type_id_uuid Int    @id @default(autoincrement())
  description         String
  contacts            CustomerHistoryContact[]

  @@map("tb_return_type")
}

model CustomerHistoryContact {
  id               Int      @id @default(autoincrement())
  message          String
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  customer_id_uuid String   @db.Uuid
  treatment_type   Int
  return_type      Int
  customer         Customer @relation(fields: [customer_id_uuid], references: [id], onDelete: Cascade)
  treatment        TreatmentType @relation(fields: [treatment_type], references: [treatment_type_id_uuid])
  return           ReturnType @relation(fields: [return_type], references: [return_type_id_uuid])

  @@index([customer_id_uuid])
  @@map("customer_contacts")
}
